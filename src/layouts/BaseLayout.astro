---
import {getImage} from 'astro:assets';
import '../styles/global.css';
import {basePath} from '../data/projects';
import socialCover from '../assets/og-home.jpg';
import portraitPhoto from '../assets/ahmed-rashwan.jpeg';
const lang=Astro.props.lang??'ar';
const noindex=Astro.props.noindex??false;
const title=Astro.props.title??'أحمد رشوان | استراتيجي تسويق ومسوق أداء';
const description=Astro.props.description??'أحمد رشوان، استراتيجي تسويق ومسوق أداء. بساعد أصحاب المشاريع يبنوا خطة تسويق واضحة وينفذوها بمحتوى وإعلانات مترابطة.';
const canonical=Astro.props.canonical;
// Share image: the designed card by default; project pages pass their cover.
const og=await getImage({src:Astro.props.image??socialCover,width:1200,height:630,fit:'cover',position:'top',format:'jpeg',quality:86});
const abs=(p:string)=>Astro.site?new URL(p,Astro.site).href:basePath(p);
const ogUrl=abs(og.src);
const portraitImg=await getImage({src:portraitPhoto,width:800,format:'jpeg',quality:86});
const siteRoot=Astro.site?new URL(basePath('/'),Astro.site).href:undefined;
const graph=Astro.site?{'@context':'https://schema.org','@graph':[
  {'@type':'Person','@id':`${siteRoot}#person`,'name':'Ahmed Rashwan','alternateName':'أحمد رشوان','jobTitle':'Marketing Strategist & Performance Marketer','url':siteRoot,'image':abs(portraitImg.src),'address':{'@type':'PostalAddress','addressCountry':'EG'},'knowsAbout':['Marketing strategy','Content strategy','Media buying','Meta Ads','Lead generation','Performance marketing'],'sameAs':['https://www.linkedin.com/in/ahmed-essam-rashwan/','https://www.facebook.com/a.rashwan90','https://www.instagram.com/a.rashwan90/']},
  {'@type':'WebSite','@id':`${siteRoot}#website`,'name':'Ahmed Rashwan','url':siteRoot,'inLanguage':['ar','en'],'publisher':{'@id':`${siteRoot}#person`}},
  {'@type':'WebPage','url':canonical,'name':title,'description':description,'inLanguage':lang,'isPartOf':{'@id':`${siteRoot}#website`},'about':{'@id':`${siteRoot}#person`}}
]}:undefined;
---
<!doctype html><html lang={lang} dir={lang==='ar'?'rtl':'ltr'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0c1220"/><link rel="icon" href={basePath("/favicon.svg")} type="image/svg+xml"/><link rel="icon" href={basePath("/favicon-32.png")} sizes="32x32" type="image/png"/><link rel="apple-touch-icon" href={basePath("/apple-touch-icon.png")}/><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:site_name" content="Ahmed Rashwan"/><meta property="og:locale" content={lang==="ar"?"ar_EG":"en_US"}/><meta property="og:locale:alternate" content={lang==="ar"?"en_US":"ar_EG"}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={ogUrl}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={lang==="ar"?"أحمد رشوان، استراتيجي تسويق ومسوق أداء":"Ahmed Rashwan, Marketing Strategist and Performance Marketer"}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogUrl}/>{canonical&&<><link rel="canonical" href={canonical}/>{Astro.props.alternateAr&&<link rel="alternate" hreflang="ar" href={Astro.props.alternateAr}/ >}{Astro.props.alternateEn&&<link rel="alternate" hreflang="en" href={Astro.props.alternateEn}/ >}<link rel="alternate" hreflang="x-default" href={Astro.props.alternateAr??basePath('/ar/')}/></>}{graph&&<script type="application/ld+json" set:html={JSON.stringify(graph)}/>}<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title><script is:inline>if(!window.matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("motion")</script></head><body><div class="scroll-progress" aria-hidden="true"></div><slot/><script>import '../scripts/site.ts';</script></body></html>

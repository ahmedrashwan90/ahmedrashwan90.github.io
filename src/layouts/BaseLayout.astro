---
import {getImage} from 'astro:assets';
import '../styles/global.css';
import {basePath} from '../data/projects';
import socialCover from '../assets/ahmed-rashwan.jpeg';
const lang=Astro.props.lang??'ar';
const title=Astro.props.title??'أحمد رشوان | استراتيجي تسويق ومسوق أداء';
const description=Astro.props.description??'أحمد رشوان، استراتيجي تسويق ومسوق أداء. بساعد أصحاب المشاريع يبنوا خطة تسويق واضحة وينفذوها بمحتوى وإعلانات مترابطة.';
const canonical=Astro.props.canonical;
const og=await getImage({src:Astro.props.image??socialCover,width:1200,height:630,fit:'cover',format:'jpeg',quality:82});
const graph=Astro.site?{'@context':'https://schema.org','@graph':[{'@type':'Person','name':'Ahmed Rashwan','jobTitle':'Marketing Strategist & Performance Marketer','url':canonical,'address':{'@type':'PostalAddress','addressCountry':'EG'},'sameAs':['https://www.facebook.com/a.rashwan90','https://www.instagram.com/a.rashwan90/','https://www.linkedin.com/in/ahmed-essam-rashwan/']},{'@type':'WebSite','name':'Ahmed Rashwan — Marketing · AI · Growth','url':Astro.site.href,'inLanguage':['ar','en']}] }:undefined;
---
<!doctype html><html lang={lang} dir={lang==='ar'?'rtl':'ltr'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0c1220"/><link rel="icon" href={basePath("/favicon.svg")} type="image/svg+xml"/><link rel="icon" href={basePath("/favicon-32.png")} sizes="32x32" type="image/png"/><link rel="apple-touch-icon" href={basePath("/apple-touch-icon.png")}/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={Astro.site?new URL(og.src,Astro.site).href:basePath(og.src)}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={Astro.site?new URL(og.src,Astro.site).href:basePath(og.src)}/>{canonical&&<><link rel="canonical" href={canonical}/>{Astro.props.alternateAr&&<link rel="alternate" hreflang="ar" href={Astro.props.alternateAr}/ >}{Astro.props.alternateEn&&<link rel="alternate" hreflang="en" href={Astro.props.alternateEn}/ >}<link rel="alternate" hreflang="x-default" href={Astro.props.alternateAr??basePath('/ar/')}/></>}{graph&&<script type="application/ld+json" set:html={JSON.stringify(graph)}/>}<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title><script is:inline>if(!window.matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("motion")</script></head><body><div class="scroll-progress" aria-hidden="true"></div><slot/><script>import '../scripts/site.ts';</script></body></html>
